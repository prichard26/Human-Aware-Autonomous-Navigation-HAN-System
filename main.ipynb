    "DISP = True\n",
    "ROBOT_SPEED = 1.11*SCALE\n",
    "NEW_SIZE = (1280, 1280)\n",
    "START = (int(SCALE*0),int(SCALE*0))\n",
    "GOAL = (int(-500*SCALE),int(900*SCALE))\n",
    "SIMULATION_TIME = 100000\n",
